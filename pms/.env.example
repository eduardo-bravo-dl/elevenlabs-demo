# Shared secret the voice agent sends in the X-Tool-Secret header.
TOOL_SECRET=change-me-to-a-long-random-string
# SQLite file path, relative to the pms/ folder.
DB_PATH=pms.sqlite3
# Simulated PMS outage: none | timeout | error
PMS_FAILURE_MODE=none
# In timeout mode the server waits longer than this, then returns 503.
PMS_TIMEOUT_SECONDS=5
